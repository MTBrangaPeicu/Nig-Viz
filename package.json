{
  "name": "my-app",
  "description": "A Marcelle Application with SvelteKit",
  "version": "0.0.0",
  "keywords": [
    "marcelle"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "backend": "marcelle-backend"
  },
  "dependencies": {
    "@marcellejs/backend": "link:../marcelle/packages/backend",
    "@marcellejs/core": "link:../marcelle/packages/core",
    "@marcellejs/gui-widgets": "link:../marcelle/packages/gui-widgets",
    "@marcellejs/layouts": "link:../marcelle/packages/layouts",
    "@marcellejs/tensorflow": "link:../marcelle/packages/tensorflow",
    "d3": "^7.9.0",
    "rxjs": "^7.8.1",
    "svelte-splitpanes": "^8.0.12"
  },
  "devDependencies": {
    "@marcellejs/devtools": "link:../marcelle/packages/devtools",
    "@sveltejs/adapter-auto": "^5.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.5.14",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.17",
    "autoprefixer": "^10.4.20",
    "daisyui": "^5.0.9",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "globals": "^15.12.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "svelte": "^5.1.13",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.17",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.2.3"
  },
  "pnpm": {
    "overrides": {
      "@marcellejs/core": "link:../marcelle/packages/core",
      "@marcellejs/gui-widgets": "link:../marcelle/packages/gui-widgets",
      "@marcellejs/layouts": "link:../marcelle/packages/layouts",
      "@marcellejs/devtools": "link:../marcelle/packages/devtools",
      "@marcellejs/tensorflow": "link:../marcelle/packages/tensorflow"
    }
  }
}